# Backend configuration (prefix JR_). Copy to .env and adjust as needed.
# The single app container serves the API + built SPA on one origin (port 8000).
JR_DEBUG=false
JR_RENDER_TIMEOUT_SECONDS=2.0
JR_MAX_TEMPLATE_BYTES=524288
JR_MAX_DATA_BYTES=1048576
JR_MAX_DATA_DEPTH=50
# Node-visit budget when validating parsed data (catches YAML alias bombs).
JR_MAX_DATA_NODES=2000000
# Max size (characters) of a single rendered output; over this -> 413.
JR_MAX_OUTPUT_BYTES=5242880
# Rate limiting: cap on tracked client buckets, and trusted reverse-proxy hops
# (client IP is read this many entries from the right of X-Forwarded-For; 0 = off).
JR_RATE_LIMIT_MAX_BUCKETS=10000
JR_TRUSTED_PROXY_HOPS=1
# Security response headers (nosniff / X-Frame-Options / Referrer-Policy).
JR_SECURITY_HEADERS_ENABLED=true
# Optional Content-Security-Policy (empty = not sent). Validate against the build
# before enabling, e.g.:
# JR_CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'
# Directory FastAPI serves the built SPA from (the image copies dist here).
# JR_STATIC_DIR=/app/static
# Optional runtime CSS override file (empty = <static_dir>/custom.css).
# JR_CUSTOM_CSS_PATH=
# Comma/JSON list of allowed CORS origins for local dev.
# JR_CORS_ORIGINS=["http://localhost:5173"]
